        "guide_arx2 = AutoDiagonalNormal(arx2_centered_diff_model)\n",
        "optimizer = Adam({\"lr\": 0.01})\n",
        "elbo = Trace_ELBO()\n",
        "svi = SVI(arx2_centered_diff_model, guide_arx2, optimizer, elbo)\n",
