        "plt.axvline(float(phi_post.mean()), color=\"C1\", linestyle=\"--\", linewidth=1, label=f\"post. mean = {phi_post.mean():.3f}\")\n",
        "plt.xlabel(\"φ\")\n",
        "plt.title(\"Prior vs posterior: AR coefficient φ\")\n",
